rules_version = '2';

// Souq Skills: private member profiles, unique usernames, shared skill
// listings and each member's saved listings.
//
// users/{uid}          The member's own profile. Only they can read or write
//                      it, so private fields such as `phone` stay private.
// users/{uid}/saved/{listingId}
//                      The listings this member saved: { listingId, savedAt }.
//                      Private to the member, like the profile.
// users/{uid}/blocked/{blockedUid}
//                      Members this member blocked: { blockedUid, blockedAt }.
//                      Private to the member; never oneself.
// publicProfiles/{uid} What other signed-in members may see: names,
//                      username and, if shared, city, bio, skills and
//                      availability. Never the phone; kept in step with
//                      users/{uid} in the same transaction.
// usernames/{key}      One claim per username, keyed by its trimmed,
//                      lower-case form: { uid, username, claimedAt }.
// reviews/{reviewId}   Ratings, once per member pair; readable by the two
//                      members, and by others only while the rated member's
//                      public profile is switched on.
// reports/{reportId}   Reports, complaints and disputes; each member can
//                      only send and read their own, and nobody can change
//                      or delete them from the app.
// listings/{listingId} Skill listings every signed-in member can browse;
//                      only the owner (`ownerId`, their uid) can change or
//                      delete them. Never holds whether anyone saved it.
// conversations/{conversationId}
//                      Direct chats between two real members, with the
//                      latest message and each member's read time. Only the
//                      two members can read them; see the chat rules below.
// conversations/{conversationId}/messages/{messageId}
//                      The chat's messages, by uid only. Never changed or
//                      deleted once sent.
// trades/{tradeId}     One-to-one trades between two real members, and
// proposals/{proposalId}  their proposals and counteroffers. Only the two
//                      members can read them; see the trade rules below.
//
// Anything not matched below is denied.
//
// The app changes a profile and its claims in one transaction
// (lib/data/profile_repository.dart), so these rules check the result of
// the whole transaction with getAfter/existsAfter:
//   - a profile's username must be claimed by its owner afterwards;
//   - a claim can only be made for the name in the claimant's profile;
//   - a rename or deletion must give up the old claim in the same write.
// Together these keep every username held by at most one account, and let
// each account hold only the claim for its current username.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function claimPath(key) {
      return /databases/$(database)/documents/usernames/$(key);
    }

    function profilePath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function publicProfilePath(uid) {
      return /databases/$(database)/documents/publicProfiles/$(uid);
    }

    // A username as shown in a profile (any case).
    function isUsername(name) {
      return name is string && name.matches('^[A-Za-z0-9_]{3,20}$');
    }

    // After this write, the caller holds the claim on [name].
    function claimedByCaller(name) {
      return getAfter(claimPath(name.lower())).data.uid == request.auth.uid;
    }

    // After this write, the caller holds no claim on [name]. Names that
    // could never be claimed, and claims held by someone else (left over
    // from before claims were enforced), need nothing released.
    function releasedByCaller(name) {
      return !isUsername(name)
        || !existsAfter(claimPath(name.lower()))
        || getAfter(claimPath(name.lower())).data.uid != request.auth.uid;
    }

    function sameUsername(before, after) {
      return before is string && before.lower() == after.lower();
    }

    // The profile being written belongs to [uid] and holds its username.
    function isValidProfile(uid) {
      return request.resource.data.id == uid
        && isUsername(request.resource.data.username)
        && claimedByCaller(request.resource.data.username);
    }

    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;

      allow create: if isOwner(uid) && isValidProfile(uid);

      allow update: if isOwner(uid)
        && isValidProfile(uid)
        && (sameUsername(resource.data.get('username', ''),
                         request.resource.data.username)
            || releasedByCaller(resource.data.get('username', '')));

      // The public profile goes in the same write, so it never outlives
      // the profile it shows.
      allow delete: if isOwner(uid)
        && releasedByCaller(resource.data.get('username', ''))
        && !existsAfter(publicProfilePath(uid));

      // users/{uid}/saved/{listingId}  The listings this member saved, as
      // written by lib/data/saved_listings_repository.dart: only
      // { listingId, savedAt }. Private to the member, like the profile.
      match /saved/{listingId} {
        allow get, list: if isOwner(uid);

        // Saving again overwrites the same document, which is an update.
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['listingId', 'savedAt'])
          && request.resource.data.listingId == listingId
          && request.resource.data.savedAt == request.time
          && exists(/databases/$(database)/documents/listings/$(listingId));

        // Also allowed once the listing is gone, so references to deleted
        // listings can be cleaned up.
        allow delete: if isOwner(uid);
      }

      // users/{uid}/blocked/{blockedUid}  Members this member blocked, as
      // written by lib/data/blocked_members_repository.dart: only
      // { blockedUid, blockedAt }. Private to the member; the blocked
      // member is never told.
      match /blocked/{blockedUid} {
        allow get, list: if isOwner(uid);

        // Blocking again overwrites the same document, which is an update.
        // Only real accounts, never oneself.
        allow create, update: if isOwner(uid)
          && blockedUid != uid
          && blockedUid.size() <= 128
          && request.resource.data.keys().hasOnly(['blockedUid', 'blockedAt'])
          && request.resource.data.blockedUid == blockedUid
          && request.resource.data.blockedAt == request.time
          && exists(profilePath(blockedUid));

        // Also once the other account is gone, so blocks can be removed.
        allow delete: if isOwner(uid);
      }
    }

    match /usernames/{key} {
      // Needed to check whether a name is free. A claim only reveals the
      // owner's uid and display username.
      allow get: if signedIn();
      allow list: if false;

      // `create` only applies when the claim does not exist yet: writing
      // over someone's claim is an update, which is never allowed.
      allow create: if signedIn()
        && key.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid', 'username', 'claimedAt'])
        && request.resource.data.uid == request.auth.uid
        && isUsername(request.resource.data.username)
        && request.resource.data.username.lower() == key
        && request.resource.data.claimedAt == request.time
        && getAfter(profilePath(request.auth.uid)).data.username.lower() == key;

      // Claims are made and given up, never handed to another account.
      allow update: if false;

      // Only the holder can give a claim up, and not while their profile
      // still uses the name.
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid
        && (!existsAfter(profilePath(request.auth.uid))
            || !sameUsername(getAfter(profilePath(request.auth.uid)).data.username, key));
    }

    // publicProfiles/{uid}  What other signed-in members may see of a member,
    //                       written in the same transaction as users/{uid}
    //                       by lib/data/profile_repository.dart
    //                       (ProfileDocument.toPublicData). Never the phone.

    function publicProfileFields() {
      return ['uid', 'firstName', 'lastName', 'username', 'city', 'bio',
              'skillsOffered', 'skillsWanted', 'availability', 'isVerified',
              'profileVisible', 'updatedAt'];
    }

    // [value] is the private profile's [mine], or left out as [blank].
    function sharedOrHidden(value, mine, blank) {
      return value == mine || value == blank;
    }

    // The public profile shows only what the member's own private profile
    // holds after this write, or less, so it can never claim another name
    // or show anything the member does not have. Without a valid private
    // profile, getAfter finds nothing and the write is refused.
    function isValidPublicProfile(uid) {
      let data = request.resource.data;
      let mine = getAfter(profilePath(uid)).data;
      return data.keys().hasOnly(publicProfileFields())
        && data.keys().hasAll(publicProfileFields())
        && data.uid == uid
        && mine.id == uid
        && isUsername(mine.username)
        && claimedByCaller(mine.username)
        && data.firstName is string && data.firstName == mine.firstName
        && data.lastName is string && data.lastName == mine.lastName
        && data.username == mine.username
        && data.city is string && sharedOrHidden(data.city, mine.city, '')
        && data.bio is string && sharedOrHidden(data.bio, mine.bio, '')
        && data.skillsOffered is list
        && sharedOrHidden(data.skillsOffered, mine.skillsOffered, [])
        && data.skillsWanted is list
        && sharedOrHidden(data.skillsWanted, mine.skillsWanted, [])
        && data.availability is string
        && sharedOrHidden(data.availability, mine.availability, '')
        // Verified means signed in with a phone number, not a stored flag.
        && data.isVerified == (request.auth.token.get('phone_number', null) is string)
        // Public profile switch: when off, only names and username are
        // shared, and the member's reviews are not shown to others.
        && data.profileVisible is bool
        && (data.profileVisible
            || (data.city == '' && data.bio == '' && data.skillsOffered == []
                && data.skillsWanted == [] && data.availability == ''))
        && data.updatedAt == request.time;
    }

    match /publicProfiles/{uid} {
      // Read one member at a time; there is no member directory to list.
      allow get: if signedIn();
      allow list: if false;

      allow create, update: if isOwner(uid) && isValidPublicProfile(uid);
      allow delete: if isOwner(uid);
    }

    // listings/{listingId}  Skill listings every member can browse, written
    //                       as in lib/data/listing_repository.dart
    //                       (ListingDocument.toData). `ownerId` is the
    //                       owner's uid. Whether a member saved a listing is
    //                       theirs alone, so `isSaved` is never stored here.

    // The fields ListingDocument.toData writes.
    function listingFields() {
      return ['ownerId', 'category', 'title', 'offers', 'wants', 'distance',
              'description', 'city', 'availability', 'sessionsMinutes',
              'onlineOnly', 'womenOnly', 'isPaused'];
    }

    function isText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    // Every listing field has the type of SkillListing, within sensible
    // bounds; text the app generates or picks from fixed choices.
    function hasValidListingFields(data) {
      return data.keys().hasAll(listingFields())
        && data.ownerId is string
        && isText(data.category, 1, 40)
        && isText(data.title, 1, 100)
        && isText(data.offers, 1, 60)
        && isText(data.wants, 1, 60)
        && isText(data.distance, 0, 20)
        && isText(data.description, 0, 1000)
        && isText(data.city, 1, 40)
        && isText(data.availability, 0, 40)
        && data.sessionsMinutes is int
        && data.sessionsMinutes >= 15 && data.sessionsMinutes <= 480
        && data.onlineOnly is bool
        && data.womenOnly is bool
        && data.isPaused is bool;
    }

    match /listings/{listingId} {
      allow get, list: if signedIn();

      // Only for oneself, with exactly the listing fields and both
      // timestamps set by the server.
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasOnly(
             listingFields().concat(['createdAt', 'updatedAt']))
        && hasValidListingFields(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Only by the owner, who stays the owner. Only listing fields and the
      // server's `updatedAt` may change, so `isSaved` can never be written;
      // fields left from older records may stay as they are.
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
             listingFields().concat(['updatedAt']))
        && hasValidListingFields(request.resource.data)
        && request.resource.data.updatedAt == request.time;

      allow delete: if signedIn()
        && resource.data.ownerId == request.auth.uid;
    }

    // reports/{reportId}  Reports, complaints and disputes, as written by
    //                     lib/data/report_repository.dart. Each member can
    //                     only send and read their own. Nobody can change or
    //                     delete one from the app: they are kept for
    //                     moderation, also after the reporter's account is
    //                     deleted, and their status is changed only by
    //                     trusted server-side tools.
    //
    // A member, trade or dispute report has the fixed id
    // {reporterUid}_{kind}_{targetId}, so each can be sent only once:
    // writing over an existing report is an update, which is refused.
    // Trade ids are those on the reporter's device for now; they are not
    // checked, as trades are not shared online yet.

    function reportFields() {
      return ['reporterId', 'kind', 'reason', 'details', 'memberId',
              'tradeId', 'listingId', 'status', 'createdAt'];
    }

    function isSafeId(id) {
      return id is string && id.matches('^[A-Za-z0-9_-]{1,128}$');
    }

    function isMemberReport(reportId, data) {
      return data.keys().hasAll(['memberId'])
        && !data.keys().hasAny(['tradeId'])
        && isSafeId(data.memberId)
        && data.memberId != request.auth.uid
        // A real account: never a demo id or a made-up one.
        && exists(profilePath(data.memberId))
        && reportId == request.auth.uid + '_memberReport_' + data.memberId;
    }

    function isTradeReport(reportId, data) {
      return data.keys().hasAll(['tradeId'])
        && !data.keys().hasAny(['memberId'])
        && isSafeId(data.tradeId)
        && reportId == request.auth.uid + '_' + data.kind + '_' + data.tradeId;
    }

    function isComplaint(data) {
      return !data.keys().hasAny(['memberId', 'tradeId']);
    }

    function isValidReport(reportId) {
      let data = request.resource.data;
      return data.keys().hasOnly(reportFields())
        && data.keys().hasAll(['reporterId', 'kind', 'reason', 'status', 'createdAt'])
        && data.reporterId == request.auth.uid
        && data.reason is string
        && data.reason.size() >= 1 && data.reason.size() <= 60
        && (!data.keys().hasAny(['details'])
            || (data.details is string && data.details.size() <= 500))
        && (!data.keys().hasAny(['listingId']) || isSafeId(data.listingId))
        && data.status == 'submitted'
        && data.createdAt == request.time
        && ((data.kind == 'memberReport' && isMemberReport(reportId, data))
            || ((data.kind == 'tradeReport' || data.kind == 'tradeDispute')
                && isTradeReport(reportId, data))
            || (data.kind == 'complaint' && isComplaint(data)));
    }

    match /reports/{reportId} {
      // Lists must be filtered by the caller's own reporterId.
      allow get, list: if signedIn()
        && resource.data.reporterId == request.auth.uid;

      allow create: if signedIn() && isValidReport(reportId);

      allow update, delete: if false;
    }

    // reviews/{reviewId}  Ratings members give each other, as written by
    //                     lib/data/review_repository.dart. Stored by uid
    //                     only: no names, phone or other profile data.
    //
    // For now each member can rate another member once: the id is
    // {reviewerUid}_{subjectUid}, so writing a second is an update, which is
    // refused. Trades are still kept on each device, so `contextId` (the
    // trade or group) is not checked: the server cannot yet confirm the
    // trade happened, was completed, or included both members.
    //
    // A member's received reviews can be read by the member themselves and
    // by the reviewer; anyone else only while the member's public profile
    // is published with the Public profile switch on. They are kept, not
    // deleted, when either account is deleted.

    function ratingTags() {
      return ['Great teacher', 'On time', 'Friendly', 'Well prepared',
              'Would trade again'];
    }

    // The member's public profile exists and is switched on.
    function isPublicProfile(uid) {
      return exists(publicProfilePath(uid))
        && get(publicProfilePath(uid)).data.get('profileVisible', false) == true;
    }

    function canReadReview(review) {
      return signedIn()
        && (review.reviewerId == request.auth.uid
            || review.subjectId == request.auth.uid
            || isPublicProfile(review.subjectId));
    }

    function isValidReview(reviewId) {
      let data = request.resource.data;
      return data.keys().hasOnly(['reviewerId', 'subjectId', 'rating', 'tags',
                                  'contextId', 'contextKind', 'skillTitle',
                                  'createdAt'])
        && data.keys().hasAll(['reviewerId', 'subjectId', 'rating', 'tags',
                               'contextId', 'contextKind', 'createdAt'])
        && data.reviewerId == request.auth.uid
        && isSafeId(data.subjectId)
        && data.subjectId != request.auth.uid
        // A real account: never a demo id or a made-up one.
        && exists(profilePath(data.subjectId))
        && reviewId == request.auth.uid + '_' + data.subjectId
        && data.rating is int && data.rating >= 1 && data.rating <= 5
        && data.tags is list && data.tags.size() <= 5
        && data.tags.toSet().size() == data.tags.size()
        && data.tags.hasOnly(ratingTags())
        && isSafeId(data.contextId)
        && data.contextKind in ['trade', 'groupTrade']
        && (!data.keys().hasAny(['skillTitle'])
            || (data.skillTitle is string && data.skillTitle.size() <= 100))
        && data.createdAt == request.time;
    }

    match /reviews/{reviewId} {
      allow get, list: if canReadReview(resource.data);
      allow create: if signedIn() && isValidReview(reviewId);
      allow update, delete: if false;
    }

    // Chats, as written by lib/data/chat_repository.dart.
    //
    // conversations/{conversationId}  One direct chat per pair of members:
    //   { kind: 'direct', participantIds: [smallerUid, largerUid],
    //     lastMessage, lastMessageId, lastSenderId, lastAt,
    //     lastReadAt: { uid: time } }
    // The id is 'dm_' + both uids in that order, so both members find the
    // same chat. Only the two members can read it.
    //
    // conversations/{conversationId}/messages/{messageId}
    //   { senderId, text, kind, proposalId?, tradeId?, createdAt }
    // Readable by the two members only; never changed or deleted.
    //
    // Every message is sent in one write with its conversation, which then
    // shows it as the latest (lastMessageId). So a message can only be sent
    // where the conversation's rules allow it: by one of its members, to a
    // member who still has an account, while neither has blocked the other.
    // The only other change a member can make is setting their own read
    // time to now.
    //
    // A proposal or trade id in a message is only checked to be a safe id,
    // not that the trade exists.

    function conversationPath(conversationId) {
      return /databases/$(database)/documents/conversations/$(conversationId);
    }

    function messagePath(conversationId, messageId) {
      return /databases/$(database)/documents/conversations/$(conversationId)/messages/$(messageId);
    }

    // [uid] blocked [otherUid] (users/{uid}/blocked/{otherUid} exists).
    function hasBlocked(uid, otherUid) {
      return exists(/databases/$(database)/documents/users/$(uid)/blocked/$(otherUid));
    }

    // The member of [ids] who is not the caller.
    function otherParticipant(ids) {
      return ids[0] == request.auth.uid ? ids[1] : ids[0];
    }

    // The caller may write to [otherUid]: both accounts exist and neither
    // blocked the other.
    function canMessage(otherUid) {
      return exists(profilePath(request.auth.uid))
        && exists(profilePath(otherUid))
        && !hasBlocked(request.auth.uid, otherUid)
        && !hasBlocked(otherUid, request.auth.uid);
    }

    // [data], the conversation after this write, shows as the latest a
    // message the caller sends in this same write, and the caller has read
    // up to now.
    function showsNewMessage(conversationId, data) {
      let path = messagePath(conversationId, data.lastMessageId);
      return isSafeId(data.lastMessageId)
        && !exists(path)
        && existsAfter(path)
        && getAfter(path).data.senderId == request.auth.uid
        && getAfter(path).data.text == data.lastMessage
        && data.lastSenderId == request.auth.uid
        && data.lastAt == request.time
        && data.lastReadAt[request.auth.uid] == request.time;
    }

    function isValidNewConversation(conversationId) {
      let data = request.resource.data;
      let ids = data.participantIds;
      return data.keys().hasOnly(['kind', 'participantIds', 'lastMessage',
                                  'lastMessageId', 'lastSenderId', 'lastAt',
                                  'lastReadAt'])
        && data.keys().hasAll(['kind', 'participantIds', 'lastMessage',
                               'lastMessageId', 'lastSenderId', 'lastAt',
                               'lastReadAt'])
        && data.kind == 'direct'
        && ids is list && ids.size() == 2
        && isSafeId(ids[0]) && isSafeId(ids[1])
        && ids[0] < ids[1]
        && request.auth.uid in ids
        && conversationId == 'dm_' + ids[0] + '_' + ids[1]
        && data.lastReadAt is map
        && data.lastReadAt.keys().hasOnly([request.auth.uid])
        && canMessage(otherParticipant(ids))
        && showsNewMessage(conversationId, data);
    }

    // Either only the caller's own read time, set to now, or a new message
    // by the caller (which also sets their read time).
    function isValidConversationUpdate(conversationId) {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return data.lastReadAt is map
        && data.lastReadAt.diff(resource.data.lastReadAt).affectedKeys()
             .hasOnly([request.auth.uid])
        && data.lastReadAt[request.auth.uid] == request.time
        && (changed.hasOnly(['lastReadAt'])
            || (changed.hasOnly(['lastMessage', 'lastMessageId',
                                 'lastSenderId', 'lastAt', 'lastReadAt'])
                && canMessage(otherParticipant(resource.data.participantIds))
                && showsNewMessage(conversationId, data)));
    }

    function isValidMessage(conversationId, messageId) {
      let data = request.resource.data;
      let conversation = getAfter(conversationPath(conversationId)).data;
      return data.keys().hasOnly(['senderId', 'text', 'kind', 'proposalId',
                                  'tradeId', 'createdAt'])
        && data.keys().hasAll(['senderId', 'text', 'kind', 'createdAt'])
        && data.senderId == request.auth.uid
        && request.auth.uid in conversation.participantIds
        // Sent together with the conversation update checked above.
        && conversation.lastMessageId == messageId
        && data.text is string
        && data.text.size() <= 1000
        && data.text.trim().size() > 0
        && data.kind in ['text', 'system', 'proposal']
        // A proposal card shows exactly one proposal; nothing else names one.
        && (data.kind == 'proposal') == data.keys().hasAny(['proposalId'])
        && (!data.keys().hasAny(['proposalId']) || isSafeId(data.proposalId))
        && (!data.keys().hasAny(['tradeId'])
            || (data.kind != 'text' && isSafeId(data.tradeId)))
        && data.createdAt == request.time;
    }

    match /conversations/{conversationId} {
      // Lists must be filtered by participantIds containing the caller.
      allow get, list: if signedIn()
        && request.auth.uid in resource.data.participantIds;

      allow create: if signedIn() && isValidNewConversation(conversationId);

      allow update: if signedIn()
        && request.auth.uid in resource.data.participantIds
        && isValidConversationUpdate(conversationId);

      allow delete: if false;

      match /messages/{messageId} {
        allow get, list: if signedIn()
          && request.auth.uid in
               get(conversationPath(conversationId)).data.participantIds;

        allow create: if signedIn() && isValidMessage(conversationId, messageId);

        allow update, delete: if false;
      }
    }

    // Trades, as written by lib/data/trade_repository.dart.
    //
    // trades/{tradeId}  A one-to-one trade between two real members:
    //   { participantIds: [smallerUid, largerUid], proposerId, termsBy,
    //     proposalId, status, offeredSkill, requestedSkill, sessionsMinutes,
    //     deliveryMethod, creditsOffered, completedBy: { uid: time },
    //     session?: { scheduledAt, method, locationOrLink, notes },
    //     createdAt, updatedAt, updatedBy }
    // The terms are those of the current proposal (proposalId), from the
    // side of its sender (termsBy): what they offer, what they want and the
    // credits they pay instead of a skill.
    //
    // proposals/{proposalId}  Each proposal and counteroffer of a trade:
    //   { tradeId, participantIds, senderId, receiverId, offeredSkill,
    //     requestedSkill, sessionsMinutes, deliveryMethod, notes,
    //     creditsOffered, status, createdAt, updatedAt }
    //
    // Stored by uid only. Only the two members can read either, and
    // nothing is deleted. Each step writes the trade and its proposals in
    // one batch or transaction, and each side checks the other:
    //   send      a new pending trade and its pending proposal (sender)
    //   counter   current proposal -> countered, a new pending proposal by
    //             the caller, and the trade's terms (either member)
    //   accept, decline  current proposal and trade (its receiver)
    //   cancel    current proposal and trade (its sender)
    //   schedule  the session of an accepted trade (either member)
    //   confirm   the caller's completedBy time; the trade becomes
    //             completed in the same write once both members confirmed
    //   dispute   accepted -> disputed (either member)
    // Sending, countering, accepting and scheduling need both accounts and
    // no block either way (canMessage); ending a trade does not. Credits
    // are not moved here: creditsOffered only records the terms.

    function tradePath(tradeId) {
      return /databases/$(database)/documents/trades/$(tradeId);
    }

    function proposalPath(proposalId) {
      return /databases/$(database)/documents/proposals/$(proposalId);
    }

    function tradeTermFields() {
      return ['offeredSkill', 'requestedSkill', 'sessionsMinutes',
              'deliveryMethod', 'creditsOffered'];
    }

    function tradeFields() {
      return ['participantIds', 'proposerId', 'termsBy', 'proposalId',
              'status', 'completedBy', 'createdAt', 'updatedAt', 'updatedBy']
        .concat(tradeTermFields());
    }

    function proposalFields() {
      return ['tradeId', 'participantIds', 'senderId', 'receiverId', 'notes',
              'status', 'createdAt', 'updatedAt'].concat(tradeTermFields());
    }

    // As TradeDocument.termsOf: a wanted skill, and a skill or credits
    // offered for it.
    function hasValidTerms(data) {
      return isText(data.offeredSkill, 0, 60)
        && isText(data.requestedSkill, 1, 60)
        && data.sessionsMinutes is int
        && data.sessionsMinutes >= 15 && data.sessionsMinutes <= 480
        && isText(data.deliveryMethod, 1, 40)
        && data.creditsOffered is int
        && data.creditsOffered >= 0 && data.creditsOffered <= 10000
        && (data.offeredSkill.size() > 0 || data.creditsOffered > 0);
    }

    function sameTerms(a, b) {
      return a.offeredSkill == b.offeredSkill
        && a.requestedSkill == b.requestedSkill
        && a.sessionsMinutes == b.sessionsMinutes
        && a.deliveryMethod == b.deliveryMethod
        && a.creditsOffered == b.creditsOffered;
    }

    function isTradeParticipants(ids) {
      return ids is list && ids.size() == 2
        && isSafeId(ids[0]) && isSafeId(ids[1])
        && ids[0] < ids[1]
        && request.auth.uid in ids;
    }

    function isValidNewTrade(tradeId) {
      let data = request.resource.data;
      return data.keys().hasOnly(tradeFields())
        && data.keys().hasAll(tradeFields())
        && isTradeParticipants(data.participantIds)
        && data.proposerId == request.auth.uid
        && data.termsBy == request.auth.uid
        && data.updatedBy == request.auth.uid
        && data.status == 'pending'
        && hasValidTerms(data)
        && data.completedBy == {}
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && isSafeId(data.proposalId)
        // Its first proposal is created in the same write; the proposal
        // rules check what it holds.
        && getAfter(proposalPath(data.proposalId)).data.tradeId == tradeId
        && canMessage(otherParticipant(data.participantIds));
    }

    // A pending proposal by the caller that is the trade's current one
    // after this write, with the same terms.
    function isValidNewProposal(proposalId) {
      let data = request.resource.data;
      let trade = getAfter(tradePath(data.tradeId)).data;
      return data.keys().hasOnly(proposalFields())
        && data.keys().hasAll(proposalFields())
        && isSafeId(data.tradeId)
        && request.auth.uid in trade.participantIds
        && data.participantIds == trade.participantIds
        && data.senderId == request.auth.uid
        && data.receiverId == otherParticipant(trade.participantIds)
        && data.status == 'pending'
        && isText(data.notes, 0, 500)
        && hasValidTerms(data)
        && trade.status == 'pending'
        && trade.proposalId == proposalId
        && trade.termsBy == request.auth.uid
        && sameTerms(data, trade)
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    // The trade's current pending proposal is countered, accepted,
    // declined or cancelled, together with the trade.
    function isValidProposalUpdate(proposalId) {
      let before = resource.data;
      let data = request.resource.data;
      let tradeBefore = get(tradePath(before.tradeId)).data;
      let tradeAfter = getAfter(tradePath(before.tradeId)).data;
      return data.diff(before).affectedKeys().hasOnly(['status', 'updatedAt'])
        && data.updatedAt == request.time
        && before.status == 'pending'
        && tradeBefore.status == 'pending'
        && tradeBefore.proposalId == proposalId
        && ((data.status == 'countered'
              && tradeAfter.status == 'pending'
              && tradeAfter.proposalId != proposalId)
            || (data.status == 'accepted'
              && before.receiverId == request.auth.uid
              && tradeAfter.status == 'accepted')
            || (data.status == 'declined'
              && before.receiverId == request.auth.uid
              && tradeAfter.status == 'declined')
            || (data.status == 'cancelled'
              && before.senderId == request.auth.uid
              && tradeAfter.status == 'cancelled'));
    }

    function isTradeCounter(before, data, changed) {
      return before.status == 'pending'
        && data.status == 'pending'
        && changed.hasOnly(tradeTermFields().concat(
             ['termsBy', 'proposalId', 'updatedAt', 'updatedBy']))
        && isSafeId(data.proposalId)
        && !exists(proposalPath(data.proposalId))
        && existsAfter(proposalPath(data.proposalId))
        && data.termsBy == request.auth.uid
        && hasValidTerms(data)
        && getAfter(proposalPath(before.proposalId)).data.status == 'countered'
        && canMessage(otherParticipant(before.participantIds));
    }

    function isTradeAnswer(before, data, changed) {
      let proposal = getAfter(proposalPath(before.proposalId)).data;
      return before.status == 'pending'
        && changed.hasOnly(['status', 'updatedAt', 'updatedBy'])
        && proposal.status == data.status
        && ((data.status == 'accepted'
              && proposal.receiverId == request.auth.uid
              && canMessage(otherParticipant(before.participantIds)))
            || (data.status == 'declined'
              && proposal.receiverId == request.auth.uid)
            || (data.status == 'cancelled'
              && proposal.senderId == request.auth.uid));
    }

    function isTradeSchedule(before, data, changed) {
      let session = data.session;
      let fields = ['scheduledAt', 'method', 'locationOrLink', 'notes'];
      return before.status == 'accepted'
        && changed.hasOnly(['session', 'updatedAt', 'updatedBy'])
        && session is map
        && session.keys().hasOnly(fields)
        && session.keys().hasAll(fields)
        && session.scheduledAt is timestamp
        && session.scheduledAt > request.time
        && isText(session.method, 1, 40)
        && isText(session.locationOrLink, 0, 200)
        && isText(session.notes, 0, 500)
        && canMessage(otherParticipant(before.participantIds));
    }

    // The caller confirms once, after a session was booked. Completed
    // exactly when both members have confirmed.
    function isTradeConfirmation(before, data, changed) {
      let ids = before.participantIds;
      let done = data.completedBy;
      return before.status == 'accepted'
        && before.keys().hasAny(['session'])
        && changed.hasOnly(['completedBy', 'status', 'updatedAt', 'updatedBy'])
        && done is map
        && !(request.auth.uid in before.completedBy)
        && done.diff(before.completedBy).affectedKeys().hasOnly([request.auth.uid])
        && done[request.auth.uid] == request.time
        && ((done.keys().hasAll(ids) && data.status == 'completed')
            || (!done.keys().hasAll(ids) && data.status == 'accepted'));
    }

    function isTradeDispute(before, data, changed) {
      return before.status == 'accepted'
        && data.status == 'disputed'
        && changed.hasOnly(['status', 'updatedAt', 'updatedBy']);
    }

    function isValidTradeUpdate() {
      let before = resource.data;
      let data = request.resource.data;
      let changed = data.diff(before).affectedKeys();
      return !changed.hasAny(['participantIds', 'proposerId', 'createdAt'])
        && data.keys().hasOnly(tradeFields().concat(['session']))
        && data.updatedBy == request.auth.uid
        && data.updatedAt == request.time
        && (isTradeCounter(before, data, changed)
            || isTradeAnswer(before, data, changed)
            || isTradeSchedule(before, data, changed)
            || isTradeConfirmation(before, data, changed)
            || isTradeDispute(before, data, changed));
    }

    match /trades/{tradeId} {
      // Lists must be filtered by participantIds containing the caller.
      allow get, list: if signedIn()
        && request.auth.uid in resource.data.participantIds;

      allow create: if signedIn() && isValidNewTrade(tradeId);

      allow update: if signedIn()
        && request.auth.uid in resource.data.participantIds
        && isValidTradeUpdate();

      allow delete: if false;
    }

    match /proposals/{proposalId} {
      // Lists must be filtered by participantIds containing the caller.
      allow get, list: if signedIn()
        && request.auth.uid in resource.data.participantIds;

      allow create: if signedIn() && isValidNewProposal(proposalId);

      allow update: if signedIn()
        && request.auth.uid in resource.data.participantIds
        && isValidProposalUpdate(proposalId);

      allow delete: if false;
    }
  }
}
